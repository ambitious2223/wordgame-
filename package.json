{
  "name": "tiktok-arabic-word-game",
  "version": "0.22.0",
  "private": true,
  "description": "TikTok LIVE Arabic word guessing game (Arabic anagram scramble).",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node smoke-test.mjs && node smoke-cards.mjs",
    "verify": "npm run typecheck && npm run lint && npx vitest run && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
